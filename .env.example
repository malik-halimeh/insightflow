# Copy to .env and fill in. .env is gitignored — never commit real values.

# MongoDB Atlas connection string, including credentials and cluster host.
MONGODB_URI="mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority"

# Database name used inside the cluster. Kept separate so staging and prod can share a cluster.
MONGODB_DB="insightflow"

# Fallback owner account, used only when no matching account exists in the database.
# Real accounts live in the `users` collection with a hashed password; this pair exists
# so a machine whose database has not been seeded yet can still sign in.
AUTH_USERNAME="owner"

# Password for that fallback account. Long and random in every deployed environment.
AUTH_PASSWORD="change-me-before-deploying"

# Password given to every account `npm run seed` creates. Development convenience only:
# the seed prints it to the terminal, so never set it to a password used anywhere real.
SEED_PASSWORD="insightflow123"

# Secret used to sign the session cookie. Rotate it and every existing session is invalidated.
SESSION_SECRET="a-32-character-or-longer-random-string"

# Absolute public origin, no trailing slash. Used for canonical URLs and share links on the
# public insight feed. NUXT_PUBLIC_ prefix exposes it to the client, so it must hold no secret.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
