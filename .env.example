# Copy to .env and fill in. .env is gitignored — never commit real values.

# MongoDB Atlas connection string, including credentials and cluster host.
MONGODB_URI="mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority"

# Database name used inside the cluster. Kept separate so staging and prod can share a cluster.
MONGODB_DB="insightflow"

# Username for a single fallback business-owner account, only used to sign in when no
# matching account exists in the `users` collection yet. Once you (or anyone) has
# created a real account from the "Create account" tab on /login, sign-in checks
# the database first and this pair is only a safety net. `npm run seed` also uses
# this to create the seeded "Bella Pizza" demo owner account.
AUTH_USERNAME="owner"

# Password for that fallback account. A random 16-character value is provided below
# so a fresh checkout is not stuck with a guessable default — replace it with your
# own random value before deploying anywhere reachable by anyone else.
AUTH_PASSWORD="TYLxQbVEyiQiGV34"

# Username and password for the seeded admin account created by `npm run seed`.
# Unlike AUTH_USERNAME/AUTH_PASSWORD, this admin account also has an env-var
# sign-in fallback (see server/api/auth/login.post.ts) — so it works to sign in
# to /admin even before `npm run seed` has been run against a fresh database.
ADMIN_USERNAME="admin"

# Same idea as AUTH_PASSWORD: a random value is provided so a fresh checkout is
# usable immediately, but replace it with your own before any real deployment.
ADMIN_PASSWORD="rnP4w*YxH4mq4ADx"

# Secret used to sign the session cookie. Rotate it and every existing session is
# invalidated. A random 32-byte value is provided below — replace it with your own
# for anything beyond local development (e.g. `openssl rand -base64 32`).
SESSION_SECRET="ZOqqJ07cOmd84-PO9Ygm08LRVmjTwR6-YO7Kj-gki4Y"

# Absolute public origin, no trailing slash. Used for canonical URLs and share links on the
# public insight feed. NUXT_PUBLIC_ prefix exposes it to the client, so it must hold no secret.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
